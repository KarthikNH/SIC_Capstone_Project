# ==============================================================================
# Gridwatch Backend & Agent Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: offline, openai, anthropic, gemini, ollama
LLM_PROVIDER=offline

# Model Name (e.g. gpt-4o-mini, claude-3-5-sonnet, gemini-1.5-flash)
LLM_MODEL=

# LLM Provider API Key (never exposed to frontend/browser clients)
LLM_API_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1

# ==============================================================================
# SMTP Email Notification Service (Leave blank for Outbox Demo Mode)
# ==============================================================================
# If SMTP_HOST is not set, Gridwatch operates in Outbox Demo Mode:
# All rendered emails (Alerts, Digests, Reports) are safely saved to data/outbox/
# and inspectable directly within the application UI.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Gridwatch Alerts <alerts@gridwatch.local>
SMTP_TLS=true
APP_BASE_URL=http://localhost:5173

# Instructions for Gmail App Password:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create an app password named 'Gridwatch'.
# 4. Set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your_email@gmail.com,
#    SMTP_PASSWORD=xxxx xxxx xxxx xxxx (the 16-character generated app password),
#    SMTP_FROM="Gridwatch Alerts <your_email@gmail.com>", SMTP_TLS=true.
